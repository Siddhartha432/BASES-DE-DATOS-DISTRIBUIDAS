CREATE VIEW dbo.Customer_Global AS
SELECT CustomerID, StoreID, TerritoryID FROM dbo.Customer_Nodo1
UNION ALL
SELECT CustomerID, StoreID, TerritoryID FROM dbo.Customer_Nodo2
UNION ALL
SELECT CustomerID, StoreID, TerritoryID FROM dbo.Customer_Nodo3
UNION ALL
SELECT CustomerID, StoreID, TerritoryID FROM dbo.Customer_Nodo4
UNION ALL
SELECT CustomerID, StoreID, TerritoryID FROM dbo.Customer_Nodo5;
GO

