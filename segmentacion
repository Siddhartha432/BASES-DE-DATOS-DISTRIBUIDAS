
-- NODO 1: Clientes Rango Northwest
CREATE TABLE dbo.Customer_Nodo1 (
    CustomerID INT NOT NULL,
    StoreID INT NULL,
    TerritoryID INT NULL,
    CONSTRAINT PK_Customer_Nodo1 PRIMARY KEY CLUSTERED (CustomerID),
    CONSTRAINT CK_Customer_Nodo1_Rango CHECK (TerritoryID = 1)
);

